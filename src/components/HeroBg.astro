---
// Subtle category-theory motif: commutative-diagram linework behind heroes.
---
<svg class="hero-bg" viewBox="0 0 900 500" fill="none" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <g stroke="var(--border-strong)" stroke-width="1" opacity="0.7">
    <path d="M120 380 L360 380 L360 200 L120 200 Z" />
    <path d="M540 380 L780 380 L780 200 L540 200 Z" />
    <path d="M360 290 L540 290" stroke-dasharray="4 6" />
    <path d="M360 240 L540 330" stroke-dasharray="4 6" opacity="0.5" />
    <path d="M240 200 L240 80 L660 80 L660 200" stroke-dasharray="2 5" opacity="0.4" />
  </g>
  <g fill="var(--accent)">
    <circle cx="120" cy="380" r="3" />
    <circle cx="360" cy="380" r="3" />
    <circle cx="360" cy="200" r="3" />
    <circle cx="120" cy="200" r="3" />
  </g>
  <g fill="var(--accent-soft)" opacity="0.85">
    <circle cx="540" cy="380" r="3" />
    <circle cx="780" cy="380" r="3" />
    <circle cx="780" cy="200" r="3" />
    <circle cx="540" cy="200" r="3" />
  </g>
  <g fill="var(--muted)" opacity="0.6">
    <circle cx="240" cy="80" r="2.5" />
    <circle cx="660" cy="80" r="2.5" />
  </g>
</svg>

<style>
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 0.55;
    pointer-events: none;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, black 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, black 30%, transparent 75%);
  }
</style>
