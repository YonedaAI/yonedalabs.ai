---
const year = new Date().getFullYear();
---
<footer>
  <div class="container">
    <div class="footer-grid">
      <div>
        <a href="/" class="footer-logo">yonedalabs<em>.ai</em></a>
        <p class="footer-tag">An AI research &amp; development lab.<br />Structure before statistics.</p>
      </div>
      <ul class="footer-links">
        <li><a href="/work">Work</a></li>
        <li><a href="/clients">Clients</a></li>
        <li><a href="/research">Research</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/resume.pdf" download>Resume</a></li>
      </ul>
    </div>
    <div class="footer-bottom">
      <span>© {year} Magneton Labs, LLC · Chicago, IL</span>
      <span>Yoneda AI · <a href="https://yonedaai.com" target="_blank" rel="noopener">yonedaai.com</a></span>
    </div>
  </div>
</footer>

<style>
  .footer-logo {
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }
  .footer-logo em { font-style: normal; color: var(--accent); }
  .footer-tag {
    color: var(--muted);
    font-size: 0.88rem;
    margin-top: 10px;
    line-height: 1.55;
  }
  .footer-bottom a { color: var(--muted); }
  .footer-bottom a:hover { color: var(--accent); }
</style>
